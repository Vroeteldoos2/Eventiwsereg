# Base URL of the Eventwise staging application.
BASE_URL=https://eventwise.synergi.dev
# Optional browser override; set to true to show Chromium.
HEADED=false
# Playwright sets this automatically in GitHub Actions.
CI=false
# Email address used to sign into the test account.
# REQUIRED
USER_EMAIL=qa@example.com
# Password for the test account; replace locally or configure as a GitHub secret.
# REQUIRED
USER_PASSWORD=replace-with-test-account-password
# Account name shown after signing in.
# REQUIRED
REGRESSION_ACCOUNT_NAME=Automation Regression Test Account
# Account ID used by account-level tests.
# REQUIRED
REGRESSION_ACCOUNT_ID=75
# Event name used by login navigation.
# Optional event name filtered by account dashboard tests.
REGRESSION_EVENT_NAME=Regression Test Event
# Tax rate used when setting up event tickets.
REGRESSION_TAX_RATE=Standard 20%
# Email recipient for PO, KPI, and account reply-to tests.
QA_EMAIL=qa@example.com
# Team member name used by the utilisation time-log comparison.
UTILISATION_TEAM_MEMBER=QA Team Member
# Account ID used by account Entries tests.
ENTRIES_ACCOUNT_ID=14
# Event name used by account Entries tests.
ENTRIES_EVENT_NAME=Regression Test Event
# Account ID used by account reporting tests.
REPORTING_ACCOUNT_ID=14
# Event name used by account reporting tests.
REPORTING_EVENT_A_NAME=Regression Test Event
# Reporting tag used by account reporting tests.
REPORTING_TAG_NAME=Techno
# Account ID used by team utilisation tests.
UTILISATION_ACCOUNT_ID=14
# User name used by the team utilisation test-user checks.
UTILISATION_TEST_USER=EWevent User
# Existing event URL used by the full regression runner.
# REQUIRED
EXISTING_EVENT_URL=https://eventwise.synergi.dev/account/<account-id>/event/<event-id>
# Optional alternate event URL used by the ticketing regression stage.
TICKETING_REGRESSION_EVENT_URL=https://eventwise.synergi.dev/account/<account-id>/event/<event-id>
# Dashboard event URL.
DASHBOARD_EVENT_URL=https://eventwise.synergi.dev/account/<account-id>/event/<event-id>
# Ticketing dashboard event URL.
TICKETING_EVENT_URL=https://eventwise.synergi.dev/account/<account-id>/event/<event-id>/tickets/dashboard
# Ticketing bulk-entry URL.
TICKETING_BULK_ENTRY_URL=https://eventwise.synergi.dev/account/<account-id>/event/<event-id>/tickets/bulk
# Budget event URL.
BUDGET_EVENT_URL=https://eventwise.synergi.dev/account/<account-id>/event/<event-id>
# Event URL used by ticket setup.
ENSURE_TICKETS_EVENT_URL=https://eventwise.synergi.dev/account/<account-id>/event/<event-id>
# Ticketing test event URL.
TICKETING_TEST_EVENT_URL=https://eventwise.synergi.dev/account/<account-id>/event/<event-id>
# Event settings test event URL.
EVENT_SETTINGS_TEST_EVENT_URL=https://eventwise.synergi.dev/account/<account-id>/event/<event-id>
# Event settings module event URL.
EVENT_SETTINGS_EVENT_URL=https://eventwise.synergi.dev/account/<account-id>/event/<event-id>
# Price-per-head test event URL.
PRICE_PER_HEAD_EVENT_URL=https://eventwise.synergi.dev/account/<account-id>/event/<event-id>
# Budget v Actuals test event URL.
BVA_EVENT_URL=https://eventwise.synergi.dev/account/<account-id>/event/<event-id>
# Revenue tickets test event URL.
REVENUE_TICKETS_EVENT_URL=https://eventwise.synergi.dev/account/<account-id>/event/<event-id>
# Invoice test event URL.
INVOICE_EVENT_URL=https://eventwise.synergi.dev/account/<account-id>/event/<event-id>
# Purchasing test event URL.
PURCHASING_EVENT_URL=https://eventwise.synergi.dev/account/<account-id>/event/<event-id>
# Approvals test event URL.
APPROVALS_EVENT_URL=https://eventwise.synergi.dev/account/<account-id>/event/<event-id>
# KPI test event URL.
KPI_EVENT_URL=https://eventwise.synergi.dev/account/<account-id>/event/<event-id>
# Closed event URL used only by the KPI closed-event check.
# REQUIRED
KPI_CLOSED_EVENT_URL=https://eventwise.synergi.dev/account/<account-id>/event/<event-id>
# Revenue test event URL.
REVENUE_EVENT_URL=https://eventwise.synergi.dev/account/<account-id>/event/<event-id>
# Event URL used by event settings tests.
EVENT_SETTINGS_EVENT_URL=https://eventwise.synergi.dev/account/<account-id>/event/<event-id>
# Approvals budget-entry subcategory.
APPROVALS_SUBCATEGORY=Travel
# Approvals supplier name.
APPROVALS_SUPPLIER=Example Supplier Ltd
# Set to 0 to disable approvals test cleanup.
APPROVALS_CLEANUP=1
# Invoice test subcategory.
INVOICE_SUBCATEGORY=Travel
# Invoice supplier that is not linked to Xero.
INVOICE_NON_XERO_SUPPLIER=Example Supplier Ltd
# Set to 0 to disable invoice test cleanup.
INVOICE_CLEANUP=1
# Purchasing test subcategory.
PURCHASING_SUBCATEGORY=Travel
# Purchasing test supplier.
PURCHASING_SUPPLIER=Example Supplier Ltd
# Set to 0 to disable purchasing test cleanup.
PURCHASING_CLEANUP=1
# Budget-entry subcategory.
# REQUIRED
BUDGET_SUBCATEGORY=Travel
# Budget-entry supplier.
# REQUIRED
BUDGET_SUPPLIER=Example Supplier Ltd
# Fixed cost used for budget entries.
BUDGET_FIXED_COST=1000
# Budgeted cost used for budget entries.
BUDGET_BUDGETED_COST=1000
# Optional Xero-linked supplier used by budget tests.
BUDGET_XERO_SUPPLIER=Example Xero Supplier
# Revenue stream used by budget tests.
BUDGET_REVENUE_STREAM=Example Revenue Stream
# Revenue subcategory used by budget tests.
# REQUIRED
BUDGET_REVENUE_SUBCATEGORY=Example Revenue Subcategory
# Revenue stream used by revenue tests.
REVENUE_STREAM=Example Revenue Stream
# Revenue subcategory used by revenue tests.
REVENUE_SUBCATEGORY=Example Revenue Subcategory
# Customer used by revenue tests.
REVENUE_CUSTOMER=Example Customer
# Email address used for revenue invoices.
REVENUE_INVOICE_EMAIL=qa@example.com
# Optional Xero-linked revenue customer.
REVENUE_XERO_CUSTOMER=Example Xero Customer
# Price-per-head revenue stream.
PPH_STREAM=Example Revenue Stream
# Ticket types used by price-per-head tests.
PPH_TICKET_TYPES=Earlybird,Main,VIP
# Attrition rate used by price-per-head tests.
PPH_ATTRITION_RATE=0
# Event-settings subcategory.
EVENT_SETTINGS_SUBCATEGORY=Travel
